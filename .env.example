# ---------------------------------------------------------------------------
# Firebase — config pública del "Web app"
# ---------------------------------------------------------------------------
# Firebase Console → Configuración del proyecto → General → Tus apps → Web app.
# Estas claves viajan en el bundle del browser: son públicas por diseño. Lo que
# protege los datos son las security rules y la verificación de sesión del
# server, no ocultar la apiKey.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — sólo server. NUNCA con prefijo NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Firebase Console → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada. Pegá el JSON entero en una sola línea, entre
# comillas simples. Da acceso total al proyecto: no lo commitees.
# Con esto la app firma las cookies de sesión y escribe en Firestore y Storage.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Notificaciones push (Web Push con VAPID)
# ---------------------------------------------------------------------------
# Generá el par con `yarn vapid` y pegá las dos líneas que imprime.
#
# NO es la clave de Firebase Cloud Messaging: la consola de Firebase entrega
# sólo la clave pública del par, y para firmar el JWT de VAPID desde nuestro
# server hace falta también la privada. Por eso el par lo generamos nosotros y
# el envío va directo al push service del navegador, sin FCM en el medio.
#
# La pública viaja en el bundle (cada `pushManager.subscribe` la manda): es
# pública por diseño. La privada NO lleva prefijo NEXT_PUBLIC_ y no se commitea:
# con ella, cualquiera puede mandarle notificaciones a tus usuarios.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A quién contactar si nuestros envíos molestan al push service. `mailto:` o URL.
VAPID_SUBJECT=mailto:emanuel00developer@gmail.com

# ---------------------------------------------------------------------------
# Herramientas de desarrollo
# ---------------------------------------------------------------------------
# `true` habilita la pantalla /debug (emitir notificaciones a mano, correr el
# dispatch de alertas sin esperar al cron, diagnóstico del push).
#
# NO lleva prefijo NEXT_PUBLIC_ a propósito: una variable pública se hornea en
# el bundle del browser, y el gate tiene que correr en el server. Con cualquier
# valor que no sea exactamente "true" queda apagada.
#
# En producción: dejala vacía o sin definir.
DEV_TOOLS=

# Secreto del cron que dispara los avisos programados (alertas de notas):
#   POST /api/notifications/dispatch  con  Authorization: Bearer <secreto>
# Sin esta variable el endpoint devuelve 401 siempre — arranca cerrado, no
# abierto. Generá uno con: openssl rand -base64 32
NOTIFICATIONS_CRON_SECRET=
