rules_version = '2';

/**
 * Security rules de Firestore.
 *
 * Estas reglas gobiernan **sólo** el acceso desde el SDK del browser. El
 * Firebase Admin SDK que usa el server las saltea por diseño: ahí la protección
 * es `requireSession()` y que cada consulta se filtre por el `uid` de la sesión.
 *
 * Criterio: el cliente puede leer lo suyo, y no puede escribir nada. Todas las
 * escrituras pasan por Server Actions, que es donde están las validaciones.
 *
 * Publicar: firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Perfil de cada cuenta. El id del documento es el uid.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Favoritos por usuario. El id del documento es el uid.
    match /favorites/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    /* Códigos de recuperación: nadie los toca desde el cliente. Aunque están
       hasheados, listarlos revelaría qué cuentas tienen un pedido pendiente. */
    match /passwordResetCodes/{code} {
      allow read, write: if false;
    }

    /* Gestor de gastos (tab Movimientos, y a futuro la mini-app que comparte
       estas mismas colecciones). Id autogenerado — el dueño se valida por
       campo (`ownerId`) en vez de por id de documento como `users`/`favorites`. */
    match /expenseCycles/{cycleId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /expenseMovements/{movementId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // ABM de categorías del gestor de gastos. El id del documento es el uid,
    // igual que `favorites`: un solo documento por cuenta con el array entero.
    match /expenseCategories/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    /* Billeteras de la mini-app Billetera y sus movimientos. Colecciones
       propias, separadas de expenseCycles/expenseMovements (ver la nota de
       diseño en docs/firestore-schema.md). Id autogenerado, mismo criterio por
       campo (`ownerId`) que el gestor de gastos: `walletMovements` duplica el
       `ownerId` de su billetera justamente para que esta regla no necesite un
       get() del documento padre. */
    match /wallets/{walletId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /walletMovements/{movementId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    /* Libro de operaciones de las billeteras de inversión. Mismo criterio por
       campo: no hereda nada del match de `wallets` —las reglas no se anidan
       por relación, sólo por ruta— y por eso `walletTrades` también duplica el
       `ownerId`. Cerrada a escritura como todo el resto: los asientos los
       escribe `recordTradeAction` con el Admin SDK, que saltea estas reglas.
       Las cotizaciones no tienen match propio porque viven en un mapa dentro
       del documento de la billetera (`wallets.quotes`), ya cubierto arriba. */
    match /walletTrades/{tradeId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // Notas de la tab Notas. Id autogenerado, mismo criterio por campo que
    // expenseCycles/expenseMovements.
    match /notes/{noteId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // Links guardados de la mini-app de links. Id autogenerado, mismo
    // criterio por campo que notes/expenseCycles.
    match /links/{linkId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // Hábitos de la tab Hábitos. Id autogenerado, mismo criterio por campo
    // que notes/links: el historial de días cumplidos (`doneDates`) vive
    // adentro del mismo documento, así que no necesita un match aparte.
    match /habits/{habitId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // Rutinas de la mini-app de entrenamiento. Id autogenerado, mismo
    // criterio por campo que habits/links: los días y ejercicios viven en
    // arrays adentro del mismo documento, así que no necesitan match aparte.
    match /workoutRoutines/{routineId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    /* Días entrenados. El id es `{uid}_{yyyy-mm-dd}`, pero el dueño se valida
       igual por campo (`ownerId`) y no parseando el id: la regla no depende
       de cómo se arme la clave, y es el mismo criterio que el resto. */
    match /workoutSessions/{sessionId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    /* Ejercicios propios del ABM de la biblioteca de entrenamiento. Id
       autogenerado, mismo criterio por campo. El catálogo base de ejercicios
       no tiene match porque no vive en Firestore: es estático, en
       `src/lib/exercise-catalog.ts`. */
    match /customExercises/{exerciseId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // Bandeja de notificaciones. Id autogenerado (o derivado de la dedupeKey),
    // mismo criterio por campo que notes/habits.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    /* Suscripciones Web Push. Cerradas también para lectura, a diferencia del
       resto: el documento guarda el endpoint y las claves de cifrado de la
       suscripción, que es exactamente lo que hace falta para mandarle un push
       a ese navegador. El cliente no las necesita — la suscripción de *este*
       dispositivo se la pide al `pushManager`, no a Firestore — y la lista de
       dispositivos de Ajustes la arma el server (`getPushDevices`), que
       saltea estas reglas. */
    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    // Preferencias de notificación. El id del documento es el uid, igual que
    // expenseCategories/favorites.
    match /notificationPreferences/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    /* Firestore ya deniega lo que ninguna regla permita — las reglas se
       combinan con OR, así que este bloque no restringe nada. Queda explícito
       para dejar claro que una colección nueva arranca cerrada hasta que se le
       escriba su propio `match`. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
